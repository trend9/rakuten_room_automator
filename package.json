{
  "name": "rakuten-room-automator",
  "version": "1.0.0",
  "description": "Automated posting and engagement tool for Rakuten ROOM",
  "main": "src/scheduler.js",
  "type": "module",
  "scripts": {
    "auth": "node src/auth.js",
    "research": "node src/research.js",
    "collect": "node src/collect.js",
    "engage": "node src/engage.js",
    "start": "node src/scheduler.js",
    "stop": "pkill -f 'node src/scheduler.js'",
    "status": "ps aux | grep -E 'scheduler.js|collect.js|engage.js' | grep -v grep",
    "logs": "echo 'Scheduler logs are output to the terminal where it is running.'"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "node-cron": "^3.0.3",
    "playwright": "^1.44.0",
    "pm2": "^7.0.1"
  }
}
